{
  "expo": {
    "name": "Campora",
    "slug": "campus-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",

    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campora.app"
    },
    "android": {
      "package": "com.campora.app",
      "adaptiveIcon": {
        "backgroundColor": "#161B33"
      }
    },
    "extra": {
      "apiUrl": "http://192.168.29.107/api",
      "_note": "Change 'localhost' above to your computer's LAN IP (e.g. http://192.168.1.42:4000/api) when testing on a physical device. See root README."
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
